<Application x:Class="MediaPlayerPro.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Τα χρώματα του θέματος ζουν στο ΕΠΙΠΕΔΟ ΕΦΑΡΜΟΓΗΣ: κάθε παράθυρο (κύριο, ήχος, βοήθεια, στατιστικά, επιλογή υποτίτλων, διάλογοι) βλέπει τα ίδια χρώματα
         και αλλάζει ζωντανά όταν αλλάζει το θέμα ή η σκούρη/φωτεινή λειτουργία. Το ApplySkin γράφει εδώ. -->
    <SolidColorBrush x:Key="BgBrush" Color="#111214"/><SolidColorBrush x:Key="BarBrush" Color="#181A1D"/><SolidColorBrush x:Key="FgBrush" Color="#E6E8EB"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA0A6"/><SolidColorBrush x:Key="AccentBrush" Color="#3B9EFF"/><SolidColorBrush x:Key="HoverBrush" Color="#2A2D33"/>
    <CornerRadius x:Key="BtnRadius">20</CornerRadius>

    <Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource BgBrush}"/><Setter Property="Foreground" Value="{DynamicResource FgBrush}"/></Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/><Setter Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Padding" Value="14,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
          <Trigger Property="IsDefault" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource BarBrush}"/><Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource FgBrush}"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource HoverBrush}"/><Setter Property="Padding" Value="5,4"/>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource BarBrush}"/><Setter Property="Foreground" Value="{DynamicResource FgBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HoverBrush}"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/><Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="b" Background="Transparent" CornerRadius="6" Margin="2,1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource FgBrush}"/></Style>
    <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource FgBrush}"/></Style>
  </Application.Resources>
</Application>
