<UserControl x:Class="MediaPlayerPro.AnimatedLogo" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="180" Height="180">
  <Viewbox>
    <Grid Width="200" Height="200">
      <Ellipse x:Name="Glow" Width="196" Height="196" RenderTransformOrigin="0.5,0.5">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#773B9EFF" Offset="0.5"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.RenderTransform><ScaleTransform x:Name="GS"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="150" Height="150" StrokeThickness="6" StrokeDashArray="5 2" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
        <Ellipse.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#00C2FF" Offset="0"/><GradientStop Color="#8A5CF6" Offset="1"/></LinearGradientBrush></Ellipse.Stroke>
        <Ellipse.RenderTransform><RotateTransform x:Name="R1"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="124" Height="124" StrokeThickness="2.5" Stroke="#66FFFFFF" StrokeDashArray="1 3.5" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform><RotateTransform x:Name="R2"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="104" Height="104" Stroke="#33FFFFFF" StrokeThickness="1">
        <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1E2F55" Offset="0"/><GradientStop Color="#0B1426" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
      </Ellipse>
      <Path Data="M 88,76 L 88,124 L 128,100 Z" StrokeLineJoin="Round" Stroke="#CFF4FF" StrokeThickness="4" RenderTransformOrigin="0.45,0.5">
        <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#7FDFFF" Offset="1"/></LinearGradientBrush></Path.Fill>
        <Path.RenderTransform><ScaleTransform x:Name="TS"/></Path.RenderTransform>
      </Path>
    </Grid>
  </Viewbox>
  <UserControl.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard><Storyboard>
        <DoubleAnimation Storyboard.TargetName="R1" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:8" RepeatBehavior="Forever"/>
        <DoubleAnimation Storyboard.TargetName="R2" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:14" RepeatBehavior="Forever"/>
        <DoubleAnimation Storyboard.TargetName="GS" Storyboard.TargetProperty="ScaleX" From="0.9" To="1.05" Duration="0:0:2.2" AutoReverse="True" RepeatBehavior="Forever"/>
        <DoubleAnimation Storyboard.TargetName="GS" Storyboard.TargetProperty="ScaleY" From="0.9" To="1.05" Duration="0:0:2.2" AutoReverse="True" RepeatBehavior="Forever"/>
        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.45" To="1" Duration="0:0:2.2" AutoReverse="True" RepeatBehavior="Forever"/>
        <DoubleAnimation Storyboard.TargetName="TS" Storyboard.TargetProperty="ScaleX" From="1" To="1.09" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
        <DoubleAnimation Storyboard.TargetName="TS" Storyboard.TargetProperty="ScaleY" From="1" To="1.09" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
      </Storyboard></BeginStoryboard>
    </EventTrigger>
  </UserControl.Triggers>
</UserControl>
