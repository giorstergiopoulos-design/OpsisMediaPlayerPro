</Menu>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ListCol" Width="Auto"/></Grid.ColumnDefinitions>
      <vlc:VideoView x:Name="Video" Background="Black">
        <Grid Background="#01000000" Focusable="True" AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_KeyDown" MouseLeftButtonDown="Video_Down" MouseWheel="Video_Wheel">
          <Grid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Αναπαραγωγή / Παύση" Tag="pp" Click="Cmd"/><MenuItem Header="Διακοπή" Tag="stop" Click="Cmd"/>
              <MenuItem Header="Προηγούμενο" Tag="prev" Click="Cmd"/><MenuItem Header="Επόμενο" Tag="next" Click="Cmd"/>
              <MenuItem Header="Πλήρης οθόνη" Tag="full" Click="Cmd"/><MenuItem Header="Λίστα αναπαραγωγής" Tag="list" Click="Cmd"/>
              <MenuItem Header="Στιγμιότυπο" Tag="snap" Click="Cmd"/><MenuItem Header="Λήψη υποτίτλων" Tag="subdl" Click="Cmd"/>
              <MenuItem Header="Πληροφορίες πολυμέσου" Tag="info" Click="Cmd"/><MenuItem Header="Έξοδος" Tag="exit" Click="Cmd"/>
            </ContextMenu>
          </Grid.ContextMenu>
          <StackPanel x:Name="Logo" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
            <local:AnimatedLogo Width="200" Height="200"/>
            <TextBlock Text="Opsis Media Player Pro" Foreground="#CFE8FF" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            <TextBlock Text="Σύρε αρχεία εδώ ή πάτα Ctrl+O" Foreground="#6F8BA8" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          </StackPanel>
          <TextBlock x:Name="Osd" Visibility="Collapsed" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="18,14" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <TextBlock.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Color="Black"/></TextBlock.Effect>
          </TextBlock>
        </Grid>
      </vlc:VideoView>
      <Border x:Name="SidePanel" Grid.Column="1" Width="300" ClipToBounds="True" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0" MouseEnter="Side_Enter" MouseLeave="Side_Leave">
        <Grid Width="298" HorizontalAlignment="Left">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel x:Name="MetaCard" Margin="14,14,14,8" Visibility="Collapsed">
            <Image x:Name="Poster" MaxHeight="230" Stretch="Uniform" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,10"/>
            <TextBlock x:Name="MetaKind" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock x:Name="MetaTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource FgBrush}" Margin="0,2,0,0"/>
            <TextBlock x:Name="MetaSub" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource FgBrush}" Margin="0,2,0,0"/>
            <TextBlock x:Name="MetaExtra" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
            <TextBlock x:Name="MetaSummary" FontSize="12.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="96" Foreground="{DynamicResource FgBrush}" Margin="0,8,0,0"/>
            <TextBlock x:Name="MetaTech" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
          </StackPanel>
          <ListBox x:Name="List" Grid.Row="1" Background="Transparent" Foreground="{DynamicResource FgBrush}" BorderThickness="0" DisplayMemberPath="Name" MouseDoubleClick="List_DoubleClick">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Εμφάνιση στον φάκελο" Tag="listfolder" Click="Cmd" />
                <MenuItem Header="Αντιγραφή διαδρομής" Tag="listcopy" Click="Cmd" />
                <MenuItem Header="Αφαίρεση από τη λίστα" Tag="plrem" Click="Cmd" />
              </ContextMenu>
            </ListBox.ContextMenu>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <Slider x:Name="Seek" Grid.Row="2" Height="22" Margin="12,6,12,0" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" Focusable="False"
            PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up"/>

    <Grid x:Name="Controls" Grid.Row="3" Background="{DynamicResource BarBrush}" Height="56">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="8,0">
        <Button Style="{StaticResource Ico}" Content="&#xE892;" Tag="prev" Click="Cmd"/>
        <Button x:Name="PlayBtn" Background="{DynamicResource AccentBrush}" Foreground="White" Style="{StaticResource Ico}" Content="&#xE768;" Tag="pp" Click="Cmd"/>
        <Button Style="{StaticResource Ico}" Content="&#xE71A;" Tag="stop" Click="Cmd"/>
        <Button Style="{StaticResource Ico}" Content="&#xE893;" Tag="next" Click="Cmd"/>
        <Button Style="{StaticResource Ico}" Content="&#xE8E5;" Click="Open_Click"/>
        <TextBlock x:Name="TimeText" Style="{StaticResource T}" Text="00:00 / 00:00" Margin="12,0,0,0"/>
      </StackPanel>
      <TextBlock x:Name="Status" Grid.Column="1" Style="{StaticResource T}" Margin="16,0" TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0">
        <TextBlock x:Name="SpeedText" Style="{StaticResource T}" Text="1×" Margin="0,0,8,0"/>
        <Button x:Name="ModeBtn" Style="{StaticResource Ico}" Content="&#xE708;" Tag="modenext" Click="Cmd" ToolTip="Σκούρη / φωτεινή / αυτόματη λειτουργία (Ctrl+Shift+L)"/>
        <Button x:Name="MuteBtn" Style="{StaticResource Ico}" Content="&#xE767;" Tag="mute" Click="Cmd"/>
        <Slider x:Name="Vol" Width="110" Minimum="0" Maximum="200" Value="80" VerticalAlignment="Center" IsMoveToPointEnabled="True" Focusable="False" ValueChanged="Vol_Changed"/>
        <Button Style="{StaticResource Ico}" Content="&#xE8FD;" Tag="list" Click="Cmd"/>
        <Button Style="{StaticResource Ico}" Content="&#xE740;" Tag="full" Click="Cmd"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
